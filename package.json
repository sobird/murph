{
  "name": "@sobird/murph",
  "version": "1.4.0",
  "description": "一个优雅的 TypeScript 项目模板，助您快速启动新项目。包含完整的 CI/CD 流水线、自动化版本管理、代码质量保障等现代化开发工具链。",
  "keywords": [
    "automation",
    "boilerplate",
    "ci-cd",
    "cli",
    "conventional-commits",
    "oxlint",
    "release-please",
    "template",
    "tsup",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/sobird/murph",
  "bugs": {
    "url": "https://github.com/sobird/murph/issues"
  },
  "license": "MIT",
  "author": "sobird",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sobird/murph.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --passWithNoTests --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@murph/core": "workspace:*",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "4.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "**/*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
